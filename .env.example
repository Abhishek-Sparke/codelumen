# =============================================================================
# CODELUMEN ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# PostgreSQL / Supabase Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/codelumen?sslmode=require"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"

# Redis Cache & Submission Queues
REDIS_URL="redis://default:password@localhost:6379"

# Isolated Code Execution Worker Sandbox (e.g. Judge0, custom Docker/gVisor runner)
CODE_EXECUTION_URL="https://judge.codelumen.internal/submissions"

# AI Socratic Coach Engine (Gemini / Claude / OpenAI API Key)
AI_API_KEY="your-ai-api-key"

# Storage Bucket (Avatars, Editorial Assets, Submissions)
STORAGE_URL="https://storage.codelumen.internal/assets"
